{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev.kangoshiquest.invalid/content_v1.schema.json",
  "title": "Kangoshi Quest event content v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "scenarioId", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contentVersion": {"type": "string", "minLength": 1},
    "scenarioId": {"const": "day_shift"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "condition": {"type":"object","additionalProperties":false,"required":["field","op","value"],"properties":{"field":{"enum":["timeMinutes","meters.hp","meters.mental","meters.bladder","meters.hunger","scores.patient","scores.team","scores.risk","tasks.record","tasks.coordination","tasks.care","tasks.total","counters.breakMinutes","flags.hasRested","flags.teamSupport"]},"op":{"enum":["eq","gte","lte"]},"value":{"oneOf":[{"type":"integer"},{"type":"boolean"}]}}},
    "modifier": {"type":"object","additionalProperties":false,"required":["conditions","factor"],"properties":{"conditions":{"type":"array","items":{"$ref":"#/$defs/condition"}},"factor":{"type":"number","exclusiveMinimum":0}}},
    "tasks": {"type":"object","additionalProperties":false,"properties":{"record":{"type":"integer","minimum":0},"coordination":{"type":"integer","minimum":0},"care":{"type":"integer","minimum":0}}},
    "effects": {"type":"object","additionalProperties":false,"required":["durationMinutes"],"properties":{"durationMinutes":{"type":"integer","minimum":1},"meterDelta":{"type":"object","additionalProperties":false,"properties":{"hp":{"type":"integer"},"mental":{"type":"integer"},"bladder":{"type":"integer"},"hunger":{"type":"integer"}}},"scoreDelta":{"type":"object","additionalProperties":false,"properties":{"patient":{"type":"integer"},"team":{"type":"integer"},"risk":{"type":"integer"}}},"createTasks":{"$ref":"#/$defs/tasks"},"completeTasks":{"$ref":"#/$defs/tasks"},"transferTasks":{"$ref":"#/$defs/tasks"},"setBladderAfter":{"const":1000},"counters":{"type":"object","additionalProperties":false,"properties":{"breakMinutes":{"type":"integer","minimum":0},"toiletCount":{"type":"integer","minimum":0,"maximum":1}}},"setFlags":{"type":"object","additionalProperties":false,"properties":{"hasRested":{"type":"boolean"},"teamSupport":{"type":"boolean"}}}}},
    "outcome": {"type":"object","additionalProperties":false,"required":["outcomeId","weight","text","effects"],"properties":{"outcomeId":{"type":"string","minLength":1},"weight":{"type":"number","exclusiveMinimum":0},"text":{"type":"string","minLength":1},"effects":{"$ref":"#/$defs/effects"},"weightModifiers":{"type":"array","items":{"$ref":"#/$defs/modifier"}}}},
    "choice": {"type":"object","additionalProperties":false,"required":["choiceId","label","hint","actionType","outcomes"],"properties":{"choiceId":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"hint":{"type":"string","minLength":1},"actionType":{"enum":["work","coordination","selfCare","rest"]},"outcomes":{"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/outcome"}}}},
    "event": {"type":"object","additionalProperties":false,"required":["eventId","title","description","category","timeRange","conditions","choices","weight","tags","maxPerRun"],"properties":{"eventId":{"type":"string","pattern":"^[A-Za-z0-9_]+$"},"title":{"type":"string","minLength":1},"description":{"type":"string","minLength":1},"category":{"type":"string","minLength":1},"timeRange":{"type":"object","additionalProperties":false,"required":["min","max"],"properties":{"min":{"type":"integer","minimum":510,"maximum":1020},"max":{"type":"integer","minimum":510,"maximum":1020}}},"conditions":{"type":"array","items":{"$ref":"#/$defs/condition"}},"choices":{"type":"array","minItems":3,"maxItems":4,"items":{"$ref":"#/$defs/choice"}},"weight":{"type":"number","exclusiveMinimum":0},"tags":{"type":"array","items":{"type":"string"}},"maxPerRun":{"const":1},"onAppear":{"type":"object","additionalProperties":false,"properties":{"callCount":{"type":"integer","minimum":0},"admissionCount":{"type":"integer","minimum":0},"acuteChangeCount":{"type":"integer","minimum":0}}},"weightModifiers":{"type":"array","items":{"$ref":"#/$defs/modifier"}},"reviewNote":{"type":"string"}}}
  }
}
